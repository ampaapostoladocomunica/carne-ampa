.date span{font-size:11px; letter-spacing:.08em; text-transform:uppercase; margin-top:3px}
.tags{display:flex; flex-wrap:wrap; gap:6px; padding:4px 14px 14px}
.tag.ok{background:var(--ok-bg); color:var(--ok)}
.tag.warn{background:var(--warn-bg); color:var(--warn)}
.tag.bad{background:var(--danger-bg); color:var(--danger)}
.tag.mine{background:var(--brand); color:var(--on-brand)}
.aviso{margin:0 14px 14px; padding:10px 12px; border-radius:10px; background:var(--warn-bg); color:var(--warn); font-size:14px; font-weight:600}
.note.ok{background:var(--ok-bg); border-color:transparent; color:var(--ok)}
.note.ok .muted{color:inherit; opacity:.85}
.detail .note b{display:inline; font-size:inherit; letter-spacing:0; text-transform:none; color:inherit}
.pubbar[hidden],.toast[hidden]{display:none}
.filebtn{position:relative; overflow:hidden; cursor:pointer}
.field .filebtn input{position:absolute; inset:0; width:100%; height:100%; min-height:0; opacity:0; padding:0; border:0; cursor:pointer}
.prow{display:grid; grid-template-columns:minmax(0,1fr) auto; gap:8px; align-items:center}
.pchips{display:flex; flex-wrap:wrap; gap:8px}
.msg-ok{color:var(--ok)}
.check{display:flex; align-items:center; gap:10px; font-weight:600; font-size:15px}
.check input{width:22px; height:22px}
.news{display:grid}
.news-item{display:grid; gap:6px; padding:12px 0; border-top:1px solid var(--line)}
.news-item:first-child{border-top:0}
.ins{display:grid; gap:6px; padding:10px 12px; border-radius:10px; background:var(--surface-2); font-size:14px; min-width:0; overflow-wrap:anywhere}
