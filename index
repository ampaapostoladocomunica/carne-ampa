const safeUrl=u=>{u=String(u||'').trim();if(!u)return'';if(!/^https?:\/\//i.test(u))u='https://'+u;return /^https?:\/\/[^\s]+$/i.test(u)?u:''};
const getPath=(o,p)=>p.split('.').reduce((x,k)=>x==null?x:x[k],o);
const setPath=(o,p,v)=>{const ks=p.split('.');const l=ks.pop();const t=ks.reduce((x,k)=>{x[k]=x[k]||{};return x[k]},o);t[l]=v};

function h53(str){let h1=0xdeadbeef,h2=0x41c6ce57;for(let i=0,ch;i<str.length;i++){ch=str.charCodeAt(i);h1=Math.imul(h1^ch,2654435761);h2=Math.imul(h2^ch,1597334677)}
  h1=Math.imul(h1^(h1>>>16),2246822507)^Math.imul(h2^(h2>>>13),3266489909);
  h2=Math.imul(h2^(h2>>>16),2246822507)^Math.imul(h1^(h1>>>13),3266489909);
  return (4294967296*(2097151&h2)+(h1>>>0)).toString(36)}
const codeHash=c=>h53(norm(c).replace(/\s+/g,''));

