  --focus:#8ab6ff; --shadow:0 0 0; color-scheme:dark;
}
*{box-sizing:border-box}
body{
  background:var(--bg); color:var(--fg); font-family:var(--font-body); font-size:16px; line-height:1.5;
  padding-block:16px calc(var(--nav-h) + 48px);
  padding-left:max(16px,env(safe-area-inset-left,0px)); padding-right:max(16px,env(safe-area-inset-right,0px));
}
h1,h2,h3,h4,p{margin:0}
h2{font:700 24px/1.15 var(--font-display); text-wrap:balance}
h3{font:700 18px/1.2 var(--font-display)}
h4{font:700 16px/1.2 var(--font-display)}
.muted{color:var(--fg-muted); font-size:14px}
.mono{font-family:var(--font-mono); font-variant-numeric:tabular-nums}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
a{color:var(--brand)}
:focus-visible{outline:3px solid var(--focus); outline-offset:2px}

.shell{max-width:520px; margin:0 auto; display:grid; gap:20px}
main{display:grid; gap:20px; min-width:0}
.stack{display:grid; gap:16px; min-width:0}
.top{display:flex; align-items:center; gap:12px}
.top h1{font:700 18px/1.15 var(--font-display)}
.top .who{min-width:0}
.top p{color:var(--fg-muted); font-size:13px; line-height:1.3}
.logo{width:46px; height:46px; flex:none; border-radius:12px; background:var(--brand-soft); color:var(--brand-soft-fg);
  display:grid; place-items:center; font:700 11px var(--font-display); letter-spacing:.08em; overflow:hidden}
.logo img{width:100%; height:100%; object-fit:contain}
.tag{display:inline-flex; align-items:center; font:600 11px var(--font-body); letter-spacing:.06em; text-transform:uppercase;
  padding:3px 8px; border-radius:999px; background:var(--surface-2); color:var(--fg-muted)}
.tag.ej{background:var(--warn-bg); color:var(--warn)}
.tag.admin{margin-left:auto; background:var(--brand-soft); color:var(--brand-soft-fg)}

.btn{min-height:44px; padding:0 18px; border-radius:12px; border:1px solid var(--line); background:var(--surface); color:var(--fg);
  font:600 15px var(--font-body); cursor:pointer; display:inline-flex; align-items:center; justify-content:center; gap:8px; text-decoration:none; text-align:center}
.btn.primary{background:var(--brand); color:var(--on-brand); border-color:transparent}
.btn.danger{color:var(--danger)}
.btn.small{min-height:36px; padding:0 12px; font-size:14px}
.btn[disabled],.btn[aria-disabled="true"]{opacity:.5; pointer-events:none}
.actions{display:flex; flex-wrap:wrap; gap:10px}

.field{display:grid; gap:6px; font-weight:600; font-size:14px; min-width:0}
.field input,.field textarea,.field select,#q{font:400 16px var(--font-body); color:var(--fg); background:var(--surface);
  border:1px solid var(--line); border-radius:10px; padding:10px 12px; min-height:46px; width:100%}
.field textarea{min-height:110px; resize:vertical}
#q{background:var(--surface)}
.hint{font-weight:400; font-size:13px; color:var(--fg-muted)}
.err{color:var(--danger); font-size:14px; min-height:1em}
.panel{background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:18px; display:grid; gap:14px; min-width:0}
.subform{display:grid; gap:12px; padding:14px; border-radius:12px; background:var(--surface-2)}
.note{background:var(--surface); border:1px solid var(--line); border-radius:14px; padding:14px 16px; display:grid; gap:6px; font-size:14px}
.note.warn{background:var(--warn-bg); border-color:transparent; color:var(--warn)}
.row-between{display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap}

/* Carnet */
.card{position:relative; overflow:hidden; border-radius:22px; padding:20px; color:var(--card-fg); min-height:236px;
  display:grid; grid-template-rows:auto 1fr auto auto; gap:14px;
  background:
    radial-gradient(circle at 105% -10%, rgb(var(--card-ink) / .16) 0 26%, transparent 26.4%),
    repeating-radial-gradient(circle at 105% -10%, transparent 0 15px, rgb(var(--card-ink) / .06) 15px 16px),
    linear-gradient(150deg,var(--card-a),var(--card-b));
  box-shadow:0 18px 40px -18px rgb(var(--shadow) / .6), inset 0 0 0 1px rgb(var(--card-ink) / .12)}
.card.expired{filter:saturate(.3)}
.card-top{display:flex; justify-content:space-between; align-items:flex-start; gap:12px}
.card-brand{display:flex; align-items:center; gap:10px; min-width:0}
.card-brand .logo{width:38px; height:38px; background:rgb(var(--card-ink) / .14); color:var(--card-fg); border-radius:10px}
.card-ampa{display:block; font:700 15px/1.15 var(--font-display)}
.card-school{display:block; font-size:11.5px; line-height:1.25; opacity:.8}
.card-state{flex:none; font:700 11px var(--font-body); letter-spacing:.1em; text-transform:uppercase; padding:5px 10px; border-radius:999px; background:var(--gold); color:var(--on-gold)}
.card.expired .card-state{background:rgb(var(--card-ink) / .22); color:var(--card-fg)}
.card-body{align-self:end; display:grid; gap:4px; min-width:0}
.card-kicker{font:600 11px var(--font-body); letter-spacing:.16em; text-transform:uppercase; color:var(--gold)}
.card-name{font:700 clamp(24px,7vw,30px)/1.1 var(--font-display); text-wrap:balance; overflow-wrap:anywhere}
.card-kids{font-size:14px; opacity:.85; overflow-wrap:anywhere}
.card-meta{display:grid; grid-template-columns:repeat(auto-fit,minmax(92px,1fr)); gap:10px}
.card-meta span{display:block; font-size:11px; letter-spacing:.08em; text-transform:uppercase; opacity:.7}
.card-meta b{font-size:15px; font-weight:600}
.seal{display:flex; justify-content:space-between; align-items:center; gap:10px; padding:10px 12px; border-radius:12px;
  background:linear-gradient(100deg, rgb(var(--card-ink) / .10) 0 38%, rgb(var(--gold-rgb) / .42) 50%, rgb(var(--card-ink) / .10) 62% 100%);
  background-size:260% 100%; animation:sweep 3.4s linear infinite}
.seal .mono{font-size:18px; font-weight:600}
.seal span:last-child{font-size:12px; text-align:right}
@keyframes sweep{from{background-position:130% 0}to{background-position:-130% 0}}
@media (prefers-reduced-motion: reduce){.seal{animation:none}}

/* Comercios */
.chips{display:flex; gap:8px; overflow-x:auto; padding-bottom:4px}
.panel>*{min-width:0}
#cform .chips{flex-wrap:wrap; overflow-x:visible}
.chip{flex:none; min-height:38px; padding:0 14px; border-radius:999px; border:1px solid var(--line); background:var(--surface); color:var(--fg); font:600 14px var(--font-body); cursor:pointer}
.chip[aria-pressed="true"]{background:var(--brand); color:var(--on-brand); border-color:transparent}
.shops{display:grid; gap:12px}
.shop{background:var(--surface); border:1px solid var(--line); border-radius:16px; overflow:hidden; min-width:0}
.shop-head{width:100%; display:grid; grid-template-columns:48px minmax(0,1fr) auto; align-items:center; gap:12px; padding:14px 14px 4px; background:none; border:0; color:inherit; font:inherit; text-align:left; cursor:pointer}
.shop-logo{width:48px; height:48px; border-radius:12px; background:var(--brand-soft); color:var(--brand-soft-fg); display:grid; place-items:center; font:700 20px var(--font-display); overflow:hidden}
.shop-logo img{width:100%; height:100%; object-fit:contain}
.shop-name{display:block; font:700 17px/1.2 var(--font-display); overflow-wrap:anywhere}
.shop-cat{display:block; font-size:13px; color:var(--fg-muted)}
.chev{width:20px; height:20px; transition:transform .15s}
.shop-head[aria-expanded="true"] .chev{transform:rotate(180deg)}
.deal{padding:6px 14px 14px 74px; font-weight:600; font-size:15px; color:var(--brand)}
.detail{border-top:1px solid var(--line); padding:14px; display:grid; gap:12px; font-size:15px}
