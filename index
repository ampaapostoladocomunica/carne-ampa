  --brand:#7a1f3d; --on-brand:#ffffff; --brand-soft:#f2dce4; --brand-soft-fg:#5b1430;
  --card-a:#8c2447; --card-b:#55112d; --card-ink:255 245 247; --card-fg:#fff5f7;
