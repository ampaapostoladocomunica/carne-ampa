async function doSignup(id){
  const a=data.actividades.find(x=>x.id===id),m=member();
  if(!a||!m||draft.busy||!canDbNow())return;
  const parts=partsList();
  if(!parts.length){draft.err='Escribe el nombre de quien participa.';refreshActs();return}
  const prev=myCount(id);
  if(a.plazas>0&&plazasLoaded){
    const free=a.plazas-Math.max(0,+a.ocupadas||0)-((occ[id]||0)-prev);
    if(parts.length>free){draft.err=free>0?'Solo quedan '+free+' plazas.':'La actividad está completa.';refreshActs();return}
  }
  draft.err='';draft.busy=true;refreshActs();
  try{
    const items=Object.assign({},(mine&&mine.items)||{});
    items[id]={participantes:parts,nota:draft.nota.trim(),ts:Date.now()};
    const ins={nombre:m.nombre,contacto:draft.tel.trim(),items:items};
    await dbh.doc('inscripciones/'+uid).set(ins);
    const n=Object.assign({},(plazasByUid[uid]&&plazasByUid[uid].n)||{});n[id]=parts.length;
    await dbh.doc('plazas/'+uid).set({n:n});
    mine=ins;plazasByUid[uid]={n:n};recomputeOcc();
    draft=emptyDraft();toast('Inscripción guardada.');
  }catch(e){
    draft.busy=false;
    const c=e&&e.code;
    if(c==='invalid_argument'){canDb=false;draft.err='Tu cuenta no puede guardar inscripciones aquí. Envía la solicitud por mensaje.'}
    else if(c==='quota_exceeded')draft.err='La base de datos está llena. Avisa al AMPA.';
    else draft.err='No se pudo guardar. Inténtalo de nuevo.';
  }
  refreshActs();
}
async function doBaja(id){
  try{
    const items=Object.assign({},(mine&&mine.items)||{});delete items[id];
    const ins=Object.assign({},mine||{},{items:items});
    await dbh.doc('inscripciones/'+uid).set(ins);
    const n=Object.assign({},(plazasByUid[uid]&&plazasByUid[uid].n)||{});delete n[id];
    await dbh.doc('plazas/'+uid).set({n:n});
    mine=ins;plazasByUid[uid]={n:n};recomputeOcc();toast('Te has dado de baja.');
  }catch(e){toast('No se pudo cancelar. Inténtalo de nuevo.')}
  confirmBaja=null;refreshActs();
}
async function removeIns(u,act){
