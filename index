  background:var(--fg); color:var(--bg); padding:10px 16px; border-radius:12px; font-size:14px; font-weight:600; text-align:center}

/* Actividades */
.act-head{width:100%; display:grid; grid-template-columns:56px minmax(0,1fr) auto; align-items:center; gap:12px; padding:14px 14px 6px; background:none; border:0; color:inherit; font:inherit; text-align:left; cursor:pointer}
