const parseISO=s=>{const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(s||'');return m?new Date(+m[1],+m[2]-1,+m[3]):null};
const fmtLong=s=>{const d=parseISO(s);return d?d.toLocaleDateString('es-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'}):''};
const isPast=a=>(!!a.fecha&&a.fecha<todayISO())||a.estado==='Finalizada';
const canDbNow=()=>!!(dbh&&uid&&canDb);
const myItem=id=>(mine&&mine.items&&mine.items[id])||null;
const myCount=id=>{const it=myItem(id);return it&&Array.isArray(it.participantes)?it.participantes.length:0};
const spotsLeft=a=>{
  if(!(a.plazas>0))return null;
  const base=Math.max(0,+a.ocupadas||0);
  if(!plazasLoaded&&!base)return null;
  return Math.max(0,a.plazas-base-(plazasLoaded?(occ[a.id]||0):0));
};
const byDate=(a,b)=>(a.fecha||'').localeCompare(b.fecha||'')||(a.hora||'').localeCompare(b.hora||'');
const emptyDraft=()=>({act:null,parts:[''],tel:'',nota:'',err:'',busy:false});
const partsList=()=>draft.parts.map(s=>String(s).trim()).filter(Boolean).slice(0,8);
function kidNames(){
  const m=member();if(!m||!m.hijos)return[];
  let depth=0,cur='';const out=[];
  for(const ch of m.hijos){
    if(ch==='(')depth++;
    if(ch===')')depth=Math.max(0,depth-1);
    if((ch===','||ch===';')&&!depth){out.push(cur);cur=''}else cur+=ch;
  }
  out.push(cur);
  return out.map(s=>s.replace(/\(.*?\)/g,'').trim()).filter(Boolean).slice(0,8);
}
function recomputeOcc(){
  occ={};
  Object.keys(plazasByUid).forEach(u=>{const n=(plazasByUid[u]||{}).n||{};Object.keys(n).forEach(k=>{const v=Math.max(0,Math.min(50,Math.floor(+n[k]||0)));occ[k]=(occ[k]||0)+v})});
}
function signState(a){
  if(a.estado==='Cancelada')return{open:false,why:'Actividad cancelada'};
  if(isPast(a))return{open:false,why:'Actividad finalizada'};
  if(a.abierta===false)return{open:false,why:'Inscripciones cerradas'};
  if(a.cierre&&todayISO()>a.cierre)return{open:false,why:'Plazo de inscripción terminado'};
  return{open:true,why:''};
}
function plazasText(a){
  if(!(a.plazas>0))return 'Sin límite de plazas';
  const l=spotsLeft(a);
  if(l===null)return a.plazas+' plazas';
  return l===0?'Completo':'Quedan '+l+' de '+a.plazas+' plazas';
}
