/* QR:start */
function qrMatrix(text){
  const ECC=[-1,10,16,26,18,24,16,18,22,22,26,30,22,22,24,24,28,28,26,26,26];
  const BLK=[-1,1,1,1,2,2,4,4,4,5,5,5,8,9,9,10,10,11,13,14,16];
  const bytes=Array.from(new TextEncoder().encode(text));
  const raw=v=>{let r=(16*v+128)*v+64;if(v>=2){const n=Math.floor(v/7)+2;r-=(25*n-10)*n-55;if(v>=7)r-=36}return r};
  let ver=1,cap=0;
  for(;;ver++){
    if(ver>20)throw new Error('largo');
    cap=(Math.floor(raw(ver)/8)-ECC[ver]*BLK[ver])*8;
    if(4+(ver<=9?8:16)+bytes.length*8<=cap)break;
  }
  const bits=[],put=(v,n)=>{for(let i=n-1;i>=0;i--)bits.push((v>>>i)&1)};
  put(4,4);put(bytes.length,ver<=9?8:16);bytes.forEach(b=>put(b,8));
  put(0,Math.min(4,cap-bits.length));put(0,(8-bits.length%8)%8);
  for(let p=0xEC;bits.length<cap;p^=0xFD)put(p,8);
  const data=[];for(let i=0;i<bits.length;i+=8){let b=0;for(let j=0;j<8;j++)b=(b<<1)|bits[i+j];data.push(b)}
  const mul=(x,y)=>{let z=0;for(let i=7;i>=0;i--){z=(z<<1)^((z>>>7)*0x11D);z^=((y>>>i)&1)*x}return z};
  const nb=BLK[ver],el=ECC[ver],rw=Math.floor(raw(ver)/8),ns=nb-rw%nb,sl=Math.floor(rw/nb);
  const div=[];for(let i=0;i<el-1;i++)div.push(0);div.push(1);
  for(let i=0,r=1;i<el;i++){for(let j=0;j<div.length;j++){div[j]=mul(div[j],r);if(j+1<div.length)div[j]^=div[j+1]}r=mul(r,2)}
  const rem=d=>{const r=div.map(()=>0);for(const b of d){const f=b^r.shift();r.push(0);div.forEach((c,i)=>{r[i]^=mul(c,f)})}return r};
  const blocks=[];
  for(let i=0,k=0;i<nb;i++){const d=data.slice(k,k+sl-el+(i<ns?0:1));k+=d.length;const e=rem(d);if(i<ns)d.push(0);blocks.push(d.concat(e))}
  const out=[];
  for(let i=0;i<blocks[0].length;i++)blocks.forEach((bl,j)=>{if(i!==sl-el||j>=ns)out.push(bl[i])});
  const size=ver*4+17,M=[],F=[];
  for(let i=0;i<size;i++){M.push(new Array(size).fill(false));F.push(new Array(size).fill(false))}
  const set=(x,y,d)=>{M[y][x]=d;F[y][x]=true};
  for(let i=0;i<size;i++){set(6,i,i%2===0);set(i,6,i%2===0)}
  const finder=(cx,cy)=>{for(let dy=-4;dy<=4;dy++)for(let dx=-4;dx<=4;dx++){const d=Math.max(Math.abs(dx),Math.abs(dy)),x=cx+dx,y=cy+dy;if(x>=0&&x<size&&y>=0&&y<size)set(x,y,d!==2&&d!==4)}};
  finder(3,3);finder(size-4,3);finder(3,size-4);
  if(ver>1){
    const n=Math.floor(ver/7)+2,st=ver===32?26:Math.ceil((ver*4+4)/(n*2-2))*2,pos=[6];
    for(let p=size-7;pos.length<n;p-=st)pos.splice(1,0,p);
    for(let a=0;a<n;a++)for(let b=0;b<n;b++){
      if((a===0&&b===0)||(a===0&&b===n-1)||(a===n-1&&b===0))continue;
      for(let dy=-2;dy<=2;dy++)for(let dx=-2;dx<=2;dx++)set(pos[a]+dx,pos[b]+dy,Math.max(Math.abs(dx),Math.abs(dy))!==1);
    }
  }
  const fmt=mask=>{
    const d=(0<<3)|mask;let r=d;for(let i=0;i<10;i++)r=(r<<1)^((r>>>9)*0x537);
    const bt=((d<<10)|r)^0x5412,g=i=>((bt>>>i)&1)!==0;
    for(let i=0;i<=5;i++)set(8,i,g(i));set(8,7,g(6));set(8,8,g(7));set(7,8,g(8));
    for(let i=9;i<15;i++)set(14-i,8,g(i));
    for(let i=0;i<8;i++)set(size-1-i,8,g(i));
    for(let i=8;i<15;i++)set(8,size-15+i,g(i));
    set(8,size-8,true);
  };
  fmt(0);
  if(ver>=7){
    let r=ver;for(let i=0;i<12;i++)r=(r<<1)^((r>>>11)*0x1F25);
    const bt=(ver<<12)|r;
    for(let i=0;i<18;i++){const b=((bt>>>i)&1)!==0,a=size-11+i%3,c=Math.floor(i/3);set(a,c,b);set(c,a,b)}
  }
  for(let i=0,right=size-1;right>=1;right-=2){
    if(right===6)right=5;
    for(let v=0;v<size;v++)for(let j=0;j<2;j++){
      const x=right-j,y=((right+1)&2)===0?size-1-v:v;
      if(!F[y][x]&&i<out.length*8){M[y][x]=((out[i>>>3]>>>(7-(i&7)))&1)!==0;i++}
    }
  }
  const apply=m=>{for(let y=0;y<size;y++)for(let x=0;x<size;x++){
    let inv;
    switch(m){case 0:inv=(x+y)%2===0;break;case 1:inv=y%2===0;break;case 2:inv=x%3===0;break;case 3:inv=(x+y)%3===0;break;
      case 4:inv=(Math.floor(x/3)+Math.floor(y/2))%2===0;break;case 5:inv=x*y%2+x*y%3===0;break;
      case 6:inv=(x*y%2+x*y%3)%2===0;break;default:inv=((x+y)%2+x*y%3)%2===0}
    if(!F[y][x]&&inv)M[y][x]=!M[y][x]}};
  const penalty=()=>{
    let s=0,dark=0;
    for(let y=0;y<size;y++){
      let run=1;
      for(let x=0;x<size;x++){
        if(M[y][x])dark++;
        if(x>0&&M[y][x]===M[y][x-1]){run++;if(run===5)s+=3;else if(run>5)s++}else run=1;
        if(y<size-1&&x<size-1&&M[y][x]===M[y][x+1]&&M[y][x]===M[y+1][x]&&M[y][x]===M[y+1][x+1])s+=3;
      }
    }
    for(let x=0;x<size;x++){let run=1;for(let y=1;y<size;y++){if(M[y][x]===M[y-1][x]){run++;if(run===5)s+=3;else if(run>5)s++}else run=1}}
    const t=size*size;s+=(Math.ceil(Math.abs(dark*20-t*10)/t)-1)*10;
    return s;
  };
  let best=0,bp=Infinity;
  for(let m=0;m<8;m++){apply(m);fmt(m);const p=penalty();if(p<bp){bp=p;best=m}apply(m)}
  apply(best);fmt(best);
  return M;
}
function qrSvgUrl(text){
  const M=qrMatrix(text),n=M.length,q=4,t=n+2*q;let d='';
  for(let y=0;y<n;y++){let x=0;while(x<n){if(M[y][x]){let e=x;while(e<n&&M[y][e])e++;d+='M'+(x+q)+' '+(y+q)+'h'+(e-x)+'v1h-'+(e-x)+'z';x=e}else x++}}
  const svg='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 '+t+' '+t+'" width="400" height="400" shape-rendering="crispEdges"><rect width="'+t+'" height="'+t+'" fill="#fff"/><path d="'+d+'" fill="#000"/></svg>';
  return 'data:image/svg+xml;base64,'+btoa(svg);
}
/* QR:end */
function makeQrFromLink(){
  if(!editing)return;
  const inp=$('#sf-qrlink');let v=inp?inp.value.trim():'';
  if(!v){logoMsg('sf-qr-msg','Escribe o pega primero el enlace del código.',false,true);return}
  if(!/^[a-z][a-z0-9+.-]*:/i.test(v)&&/^(www\.)?[a-z0-9-]+(\.[a-z0-9-]+)*\.[a-z]{2,}(\/\S*)?$/i.test(v))v='https://'+v;
  try{
    const u=qrSvgUrl(v);editing.qr=u;
    const pv=$('#sfQrPrev');if(pv)pv.innerHTML='<img src="'+esc(u)+'" alt="">';
    logoMsg('sf-qr-msg','QR creado con «'+(v.length>40?v.slice(0,40)+'…':v)+'». Pulsa Guardar comercio y después Publicar.',true);
  }catch(err){logoMsg('sf-qr-msg',err&&err.message==='largo'?'El enlace es demasiado largo para un QR. Prueba con uno más corto.':'No se pudo crear el QR.',false,true)}
}
app.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target&&e.target.id==='sf-qrlink'){e.preventDefault();makeQrFromLink()}});
const IMGK={logo:{max:192,prev:'#sfPrev',msg:'sf-logo-msg',ok:'Logo cargado. Pulsa Guardar comercio.'},qr:{max:900,prev:'#sfQrPrev',msg:'sf-qr-msg',ok:'Imagen cargada. Pulsa Guardar comercio y después Publicar.'}};
async function setShopImg(kind,file){
  if(!editing||!file)return;const k=IMGK[kind];if(!k)return;
  logoMsg(k.msg,'Leyendo '+fdesc(file)+'…');
  try{
    const u=await shrink(file,k.max);editing[kind]=u;
    const p=$(k.prev);if(p)p.innerHTML='<img src="'+esc(u)+'" alt="">';
    logoMsg(k.msg,k.ok,true);
  }catch(err){logoMsg(k.msg,'No se pudo cargar '+fdesc(file)+'. Fallo en: '+((err&&err.stage)||'paso desconocido')+'. Prueba con otro PNG o JPG.',false,true)}
}
function closeQr(){const o=document.getElementById('qrov');if(o)o.remove()}
function openQr(c){
  closeQr();
  const o=document.createElement('div');o.className='qrov';o.id='qrov';o.setAttribute('role','dialog');o.setAttribute('aria-label','Código de '+c.nombre);
  o.innerHTML='<b></b><img alt=""><button class="btn primary" type="button">Cerrar</button>';
  o.querySelector('b').textContent=c.nombre;
  const im=o.querySelector('img');im.alt='Código QR de '+c.nombre;
  im.onload=()=>{if(im.naturalWidth&&im.naturalWidth<360)im.style.imageRendering='pixelated'};
  im.src=c.qr;
  o.addEventListener('click',closeQr);
  document.body.appendChild(o);
  try{o.querySelector('button').focus()}catch(er){}
}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeQr()});
const dropBox=e=>{const t=e.target;return t&&t.closest?t.closest('.dropt'):null};
app.addEventListener('dragover',e=>{const b=dropBox(e);if(b&&editing){e.preventDefault();b.classList.add('over')}});
app.addEventListener('dragleave',e=>{const b=dropBox(e);if(b)b.classList.remove('over')});
app.addEventListener('drop',e=>{
  const b=dropBox(e);if(!b||!editing)return;e.preventDefault();b.classList.remove('over');
  const f=[...((e.dataTransfer&&e.dataTransfer.files)||[])].find(x=>/^image\//.test(x.type));
  if(f)setShopImg(b.dataset.t,f);else logoMsg(IMGK[b.dataset.t].msg,'Eso no parece una imagen.',false,true);
});
document.addEventListener('paste',e=>{
  if(!editing||!$('#shopForm'))return;
  const f=[...((e.clipboardData&&e.clipboardData.files)||[])].find(x=>/^image\//.test(x.type));if(!f)return;
  e.preventDefault();
  const a=document.activeElement,box=a&&a.closest?a.closest('.dropt'):null;
  setShopImg(box?box.dataset.t:'qr',f);
});

app.addEventListener('change',async e=>{
  const t=e.target;
  if(t.id==='sf-qr'&&t.files&&t.files[0]&&editing){const file=t.files[0];await setShopImg('qr',file);try{t.value=''}catch(er){}return}
  if(t.id==='g-code'){
    const v=t.value.trim();if(!v)return;
    if(v.length<4){toast('El código debe tener al menos 4 caracteres.');return}
    data.ampa.codeHash=codeHash(v);t.value='';t.placeholder='Código puesto. Escribe uno nuevo para cambiarlo';mark();toast('Código guardado. Falta publicar.');return
  }
  if(t.id==='g-logo'&&t.files&&t.files[0]){
    const file=t.files[0];
    logoMsg('g-logo-msg','Leyendo '+fdesc(file)+'…');
    try{
      data.ampa.logo=await shrink(file,256);mark();
      const p=$('#gPrev');if(p)p.innerHTML='<img src="'+esc(data.ampa.logo)+'" alt="">';
      logoMsg('g-logo-msg','Logo cargado. Pulsa Publicar para que lo vean las familias.',true);
    }catch(err){logoMsg('g-logo-msg','No se pudo cargar '+fdesc(file)+'. Fallo en: '+((err&&err.stage)||'paso desconocido')+'. Prueba con otro PNG o JPG.',false,true)}
    try{t.value=''}catch(er){}
    return
  }
  if(t.id==='sf-logo'&&t.files&&t.files[0]&&editing){
    const file=t.files[0];
    logoMsg('sf-logo-msg','Leyendo '+fdesc(file)+'…');
    try{
      editing.logo=await shrink(file,128);
      const p=$('#sfPrev');if(p)p.innerHTML='<img src="'+esc(editing.logo)+'" alt="">';
      logoMsg('sf-logo-msg','Logo cargado. Pulsa Guardar comercio.',true);
    }catch(err){logoMsg('sf-logo-msg','No se pudo cargar '+fdesc(file)+'. Fallo en: '+((err&&err.stage)||'paso desconocido')+'. Prueba con otro PNG o JPG.',false,true)}
    try{t.value=''}catch(er){}
  }
});
app.addEventListener('submit',e=>{
  e.preventDefault();
  const f=e.target;
  if(f.id==='setup'){
    const nombre=$('#s-nombre').value.trim(),hijos=$('#s-hijos').value.trim();
    const err=$('#s-err');
    if(!nombre){err.textContent='Escribe tu nombre para crear el carnet.';return}
    if(data.ampa.codeHash){const c=$('#s-code');if(!c||codeHash(c.value)!==data.ampa.codeHash){err.textContent='Ese código no es correcto. Pídeselo al AMPA.';return}}
    store.set(KEY,{nombre:nombre,hijos:hijos,ch:data.ampa.codeHash||null});
    memberEditing=false;render();return
  }
  if(f.id==='signForm'){doSignup(f.dataset.id);return}
  if(f.id==='actForm'){
    const fd=new FormData(f);const g=k=>String(fd.get(k)||'').trim();
    const o={id:editingAct.id||('a'+Date.now().toString(36)),titulo:g('titulo'),tipo:g('tipo'),desc:g('desc'),fecha:g('fecha'),hora:g('hora'),lugar:g('lugar'),plazas:Math.max(0,Math.min(999,parseInt(g('plazas'),10)||0)),cierre:g('cierre'),estado:g('estado')||'Confirmada',aviso:g('aviso'),abierta:fd.get('abierta')==='on',ocupadas:Math.max(0,Math.min(999,parseInt(g('ocupadas'),10)||0)),enlace:safeUrl(g('enlace')),ejemplo:false};
    if(!o.titulo||!o.fecha){$('#af-err').textContent='Rellena el título y la fecha.';return}
    if(g('enlace')&&!o.enlace){$('#af-err').textContent='El enlace del formulario no es válido.';return}
    const i=data.actividades.findIndex(x=>x.id===o.id);if(i>=0)data.actividades[i]=o;else data.actividades.push(o);
    editingAct=null;mark();render();toast('Actividad guardada. Falta publicar.');return
  }
  if(f.id==='newsForm'){
    const fd=new FormData(f);const g=k=>String(fd.get(k)||'').trim();
    const o={id:'n'+Date.now().toString(36),fecha:todayISO(),titulo:g('titulo'),texto:g('texto'),actId:g('actId'),ejemplo:false};
    if(!o.titulo){$('#nf-err').textContent='Escribe un título.';return}
    data.novedades.push(o);newsForm=null;mark();render();toast('Novedad guardada. Falta publicar.');return
  }
  if(f.id==='shopForm'){
    const fd=new FormData(f);const g=k=>String(fd.get(k)||'').trim();
    const o={id:editing.id||('c'+Date.now().toString(36)),nombre:g('nombre'),cat:g('cat'),ventaja:g('ventaja'),cond:g('cond'),dir:g('dir'),tel:g('tel'),web:g('web'),logo:editing.logo||null,qr:editing.qr||null,ejemplo:false};
    if(!o.nombre||!o.cat||!o.ventaja){$('#sf-err').textContent='Rellena el nombre, la categoría y la ventaja.';return}
    const i=data.comercios.findIndex(x=>x.id===o.id);if(i>=0)data.comercios[i]=o;else data.comercios.push(o);
    editing=null;mark();render();toast('Comercio guardado. Falta publicar.');
  }
});

/* Las familias nunca llaman a las funciones de Claude: solo se comprueba la administración
   si este dispositivo ya la usó, si se abre con #gestion o si se pulsa «Acceso AMPA». */
async function detectAdmin(){
  let ok=false,pub=false;
  try{const u=window.claude&&window.claude.use?await window.claude.use('user'):null;ok=u?!!(await u.canEdit()):false}catch(e){}
  if(ok){try{const a=window.claude&&window.claude.use?await window.claude.use('artifact'):null;pub=!!a}catch(e){}}
  isAdmin=ok;canPublish=pub;
  try{if(ok)localStorage.setItem(KEYADM,'1');else localStorage.removeItem(KEYADM)}catch(e){}
  render();return ok;
}
render();
initDb();
(async()=>{
  let flag=false;try{flag=localStorage.getItem(KEYADM)==='1'}catch(e){}
  if(flag||location.hash==='#gestion')await detectAdmin();
})();
})();
