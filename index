const fdesc=f=>'«'+(f.name||'imagen')+'» ('+(f.type||'tipo desconocido')+', '+Math.max(1,Math.round((f.size||0)/1024))+' KB)';
function shrink(file,max){
  return new Promise((res,rej)=>{
    const fail=stage=>{const e=new Error(stage);e.stage=stage;rej(e)};
    const fr=new FileReader();
    fr.onerror=()=>fail('lectura del archivo');
    fr.onload=()=>{
      const url=String(fr.result||'');
      const raw=()=>url.length<=250000?res(url):fail('imagen demasiado grande');
      if(/^data:image\/svg/i.test(url)){raw();return}
      const im=new Image();
      im.onerror=()=>fail('el navegador no puede abrir esta imagen');
      im.onload=()=>{
        if(!im.width||!im.height){raw();return}
        try{
          const s=Math.min(1,max/Math.max(im.width,im.height));
          const c=document.createElement('canvas');
          c.width=Math.max(1,Math.round(im.width*s));c.height=Math.max(1,Math.round(im.height*s));
          c.getContext('2d').drawImage(im,0,0,c.width,c.height);
          let out=c.toDataURL('image/png');if(out.length>140000)out=c.toDataURL('image/webp',0.85);
          res(out);
        }catch(e){raw()}
      };
      im.src=url;
    };
    fr.readAsDataURL(file);
  });
}

