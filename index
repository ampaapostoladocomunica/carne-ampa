async function downloadHtml(){
  const set=t=>{const m=document.getElementById('dlmsg');if(m)m.textContent=t};
  set('Preparando el archivo…');
  try{
    const dl=window.claude&&window.claude.use?await window.claude.use('downloads'):null;
    if(!dl)throw {code:'unavailable'};
    await dl.save({filename:'index.html',data:standaloneDoc()});
    set('Archivo guardado. Súbelo a tu web con el nombre index.html.');
  }catch(err){
    const c=err&&err.code;
    set(c==='declined'?'Descarga cancelada.':(c==='unavailable'||c==='not_granted'||c==='capability_disabled')?'Desde aquí no se puede descargar. Abre la página desde el ordenador.':c==='rate_limited'?'Espera un momento y vuelve a pulsar.':'No se pudo descargar el archivo.');
  }
}
async function publish(){
  if(busy)return;
  busy=true;pubMsg='Publicando…';updatePub();
  try{
    const art=await window.claude.use('artifact');
    if(!art)throw {code:'not_granted'};
    await art.publish(buildDoc());
    pubMsg='Publicado. Actualizando…';
  }catch(err){
    const c=err&&err.code;
    pubMsg=c==='conflict'?'Se publicó otra versión antes. La página se recargará: repite tus cambios.'
      :(c==='not_writer'||c==='not_granted'||c==='capability_disabled'||c==='not_declared')?'Esta cuenta no puede publicar cambios en la app.'
      :c==='too_large'?'La página es demasiado grande. Usa logos más pequeños.'
      :c==='rate_limited'?'Demasiados cambios seguidos. Espera un momento y vuelve a publicar.'
      :'No se pudo publicar. Inténtalo de nuevo.';
  }
  busy=false;updatePub();
}

